# Example environment file for bayesian-aenet.
# Copy this file to ".env" (which is gitignored) and fill in your own values.
#
# .env is loaded automatically by bnn_aenet/tasks/train.py.
# Hydra can reference these variables in .yaml configs as ${oc.env:MY_VAR}.

# Absolute path to the package root used by configs that resolve paths from env.
MY_VAR="/path/to/bayesaenet/bnn_aenet"
