TRAININGSET /work/g15farris/database/TiO/TiO.train.ascii
TESTPERCENT 10
VALIDPERCENT 10
ITERATIONS 200000
ITERWRITE 1
BATCHSIZE 64
NPSEED 1
PHSEED 2

MEMORY_MODE gpu

SAVE_ENERGIES
SAVE_FORCES
VERBOSE

FORCES
alpha=0.5

METHOD
method=adamw   lr=0.0001

REGULARIZATION 0.001

NETWORKS
! atom   network         hidden
! types  file-name       layers  nodes:activation
  Ti     Ti.pytorch.nn    2    15:tanh    15:tanh
  O       O.pytorch.nn    2    15:tanh    15:tanh
